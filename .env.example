# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173

# --- MongoDB (source of truth) ---
# Use a dedicated least-privilege user (readWrite on this database only) outside local dev.
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
# Defaults to true outside production. In production build indexes with `npm run db:indexes`.
MONGODB_AUTO_INDEX=
DB_QUERY_TIMEOUT_MS=5000

# --- Redis (optional: distributed rate limits + dashboard cache) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (min 32 chars each, distinct, random) ---
ACCESS_TOKEN_SECRET=replace-with-a-long-random-value-at-least-32-chars
COOKIE_SECRET=replace-with-a-different-long-random-value-32-chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
SESSION_ABSOLUTE_TTL=2592000
# Defaults to true in production. Leave empty for local http development.
COOKIE_SECURE=
# Number of trusted reverse-proxy hops in front of the API (0 = none; 1 behind one LB/nginx).
TRUST_PROXY=0

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_ACCOUNT_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_MAX=120

# --- Backpressure / lifecycle ---
MAX_IN_FLIGHT=2000
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=20000

# --- Cache ---
DASHBOARD_CACHE_TTL_SECONDS=60

# --- Observability ---
LOG_LEVEL=info
# Bearer token required to scrape /metrics. If unset, /metrics is disabled in production.
METRICS_TOKEN=
